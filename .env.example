# Issued at https://my.telegram.org under API development tools.
API_ID=12345678
API_HASH=replace_with_your_api_hash

# Generate with: PYTHONPATH=src python -m noche_relay.session_tool
TELEGRAM_SESSION=replace_with_your_string_session

SOURCE_CHANNEL=@aetherjapanresearch
TARGET_CHANNEL=@noche_economic

# continuous: keep one process connected; poll: run once and exit for GitHub Actions.
RUN_MODE=continuous

# sqlite is for Docker/VM. Use supabase for short-lived GitHub Actions runs.
STATE_BACKEND=sqlite
STATE_DB_PATH=./data/relay.sqlite3
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# In poll mode, recheck this many recent relayed messages for caption/text edits.
EDIT_LOOKBACK=100
# Avoid copying an album while Telegram is still assembling it.
POLL_SETTLE_SECONDS=30
LOG_LEVEL=INFO
SILENT=false
